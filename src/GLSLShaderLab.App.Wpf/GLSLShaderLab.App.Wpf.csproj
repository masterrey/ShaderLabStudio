<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GLSLShaderLab.Core\GLSLShaderLab.Core.csproj" />
    <ProjectReference Include="..\GLSLShaderLab.Engine\GLSLShaderLab.Engine.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\ShaderLabStudio.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK.GLControl" Version="4.0.2" />
  </ItemGroup>

  <!-- Embed the .ico as a WPF resource so Icon="Assets/ShaderLabStudio.ico" resolves at runtime -->
  <ItemGroup>
    <Resource Include="Assets\ShaderLabStudio.ico" />
  </ItemGroup>

  <!-- Ensure native DLLs land in the app root so P/Invoke finds them on every machine -->
  <ItemGroup>
    <Content Include="$(NuGetPackageRoot)assimpnet\5.0.0-beta1\runtimes\win-x64\native\assimp.dll"
            Link="assimp.dll"
            CopyToOutputDirectory="PreserveNewest"
            Condition="Exists('$(NuGetPackageRoot)assimpnet\\5.0.0-beta1\\runtimes\\win-x64\\native\\assimp.dll')" />
  </ItemGroup>

</Project>
